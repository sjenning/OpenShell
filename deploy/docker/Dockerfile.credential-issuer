# Uses the same staged GNU binary and pinned glibc runtime as the gateway.
ARG ISSUER_BASE_IMAGE=gcr.io/distroless/cc-debian13:nonroot@sha256:e792ab3d241a468a4fd7519ddbbebe66b49b5f365771716ea688ad40b6c6f1c2
FROM ${ISSUER_BASE_IMAGE} AS credential-issuer

ARG TARGETARCH
WORKDIR /app
COPY deploy/docker/.build/prebuilt-binaries/${TARGETARCH}/openshell-credential-issuer /usr/local/bin/openshell-credential-issuer
USER 1000:1000
EXPOSE 8443
ENTRYPOINT ["/usr/local/bin/openshell-credential-issuer"]
CMD ["--config", "/etc/openshell-issuer/issuer.toml"]
